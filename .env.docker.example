# --- Core ---
CYGNET_VERSION=1.0.1
PYTHONUNBUFFERED=1

# --- Database ---
POSTGRES_USER=cygnet
POSTGRES_PASSWORD=cygnet_pass
POSTGRES_DB=energy_db

# --- App/Auth ---
AUTH_BYPASS_DEV=true

# IMPORTANT: inside Docker, Streamlit must call API via service name
CYGNET_API_URL=http://api:8001
APP_PORT=8501

# --- ENTSO-E / EIA ---
API_TOKEN=your_entsoe_token_here
ENTSOE_API_TOKEN=your_entsoe_token_here
EIA_API_KEY=your_eia_key_here

# --- LLM Backends ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# API container should reach host Ollama via host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini
HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
