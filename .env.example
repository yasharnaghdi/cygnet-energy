# --- Core ---
CYGNET_VERSION=1.0.1
PYTHONUNBUFFERED=1

# --- Database ---
POSTGRES_USER=cygnet
POSTGRES_PASSWORD=cygnet_pass
POSTGRES_DB=energy_db
DATABASE_URL=postgresql://cygnet:cygnet_pass@localhost:5433/energy_db

# --- ENTSO-E / EIA ---
# Keep API_TOKEN and ENTSOE_API_TOKEN in sync for compatibility.
API_TOKEN=your_entsoe_token_here
ENTSOE_API_TOKEN=your_entsoe_token_here
EIA_API_KEY=your_eia_key_here

# --- Auth ---
# true = local bypass; false = require bearer token validation
AUTH_BYPASS_DEV=false
AUTH_BYPASS_SUB=dev-user
AUTH_BYPASS_EMAIL=dev-user@local
AUTH_BYPASS_ROLES=analyst
AUTH_BYPASS_SCOPES=api.read

# OIDC (required when AUTH_BYPASS_DEV=false)
OIDC_ISSUER=https://keycloak.example.com/realms/cygnet
OIDC_JWKS_URL=https://keycloak.example.com/realms/cygnet/protocol/openid-connect/certs
OIDC_AUDIENCE=cygnet-api
OIDC_REQUIRED_SCOPES=api.read
OIDC_REQUIRED_ROLES=analyst
OIDC_JWKS_CACHE_SECONDS=300

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Other options: phi3:mini, tinyllama, mistral

# --- HuggingFace (in-process) ---
HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# Other options: meta-llama/Llama-2-7b-chat-hf, microsoft/phi-2

# --- Streamlit ---
CYGNET_API_URL=http://localhost:8001
APP_PORT=8501
CYGNET_SESSION_FILE=.cygnet_session

# --- Optional oauth2-proxy values ---
OAUTH2_PROXY_CLIENT_ID=cygnet-streamlit
OAUTH2_PROXY_CLIENT_SECRET=replace_with_client_secret
OAUTH2_PROXY_COOKIE_SECRET=replace_with_32b_base64
OAUTH2_PROXY_ISSUER_URL=${OIDC_ISSUER}
OAUTH2_PROXY_REDIRECT_URL=https://dashboard.example.com/oauth2/callback
OAUTH2_PROXY_SCOPE=openid profile email
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=true

# --- Security headers / metrics ---
CSP_DEFAULT_SRC='self'
CSP_IMG_SRC='self data: https:'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self https://fonts.googleapis.com'
CSP_CONNECT_SRC='self https://api.example.com'
CSP_FRAME_ANCESTORS='none'
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- Optional S3 report backup ---
AWS_S3_BUCKET=
AWS_S3_PREFIX=reports
