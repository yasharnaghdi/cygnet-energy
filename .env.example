# --- Core app configuration ---
CYGNET_VERSION=1.0.1
PYTHONUNBUFFERED=1

# --- Database (replace with real secrets in deployment) ---
POSTGRES_USER=cygnet
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=energy_db
DATABASE_URL=postgresql://cygnet:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- ENTSO-E API ---
# Legacy app code expects API_TOKEN, newer deployment files use ENTSOE_API_TOKEN.
# Set both to the same value for compatibility.
API_TOKEN=replace_with_token
ENTSOE_API_TOKEN=replace_with_token
EIA_API_KEY=replace_with_eia_key

# --- LLM / AI backend ---
CYGNET_API_URL=http://127.0.0.1:8001
APP_PORT=8501
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# --- OIDC / JWT resource server (Keycloak / Auth0 / Okta / Azure AD) ---
OIDC_ISSUER=https://keycloak.example.com/realms/cygnet
OIDC_JWKS_URL=https://keycloak.example.com/realms/cygnet/protocol/openid-connect/certs
OIDC_AUDIENCE=cygnet-api
# Comma-separated required scopes (space-delimited in token); leave empty to skip
OIDC_REQUIRED_SCOPES=api.read
# Comma-separated required roles (realm or client roles depending on IdP mapping)
OIDC_REQUIRED_ROLES=analyst
# Seconds to cache JWKS; default 300
OIDC_JWKS_CACHE_SECONDS=300
# Local-only bypass for development without a live OIDC provider
AUTH_BYPASS_DEV=false

# --- Reverse proxy / oauth2-proxy (example Keycloak values) ---
OAUTH2_PROXY_CLIENT_ID=cygnet-streamlit
OAUTH2_PROXY_CLIENT_SECRET=replace_with_client_secret
OAUTH2_PROXY_COOKIE_SECRET=replace_with_32b_base64
OAUTH2_PROXY_ISSUER_URL=${OIDC_ISSUER}
OAUTH2_PROXY_REDIRECT_URL=https://dashboard.example.com/oauth2/callback
OAUTH2_PROXY_SCOPE=openid profile email
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=true

# --- Security headers (optional overrides consumed by nginx template) ---
CSP_DEFAULT_SRC='self'
CSP_IMG_SRC='self data: https:'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self https://fonts.googleapis.com'
CSP_CONNECT_SRC='self https://api.example.com'
CSP_FRAME_ANCESTORS='none'

# --- Observability ---
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
